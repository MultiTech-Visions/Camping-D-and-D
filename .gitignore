# Dependencies are installed ON the Pi by install.sh (native modules must match the Pi's CPU)
node_modules/

# Live game data — never overwritten by updates
data/

# Run logs (install / start / update / server) — local to each machine
logs/

# OS noise
.DS_Store
Thumbs.db

# Uploaded battle maps / token art are game content, not code
public/assets/maps/*
public/assets/tokens/*
!public/assets/maps/.gitkeep
!public/assets/tokens/.gitkeep
